generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  MANAGER
  FINANCE
  ADMIN
}

enum PurchaseOrderStatus {
  PENDING_MANAGER
  PENDING_FINANCE
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  initials     String
  department   String
  role         Role
  createdAt    DateTime @default(now())

  purchaseOrders PurchaseOrder[]
}

model Vendor {
  id             String          @id @default(cuid())
  name           String          @unique
  purchaseOrders PurchaseOrder[]
}

model Warehouse {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  stockLevels    StockLevel[]
  purchaseOrders PurchaseOrder[]
}

model Item {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  category     String
  reorderPoint Int
  stockLevels  StockLevel[]
}

model StockLevel {
  id            String    @id @default(cuid())
  item          Item      @relation(fields: [itemId], references: [id])
  itemId        String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId   String
  onHand        Int
  reserved      Int
  lastMovement  DateTime  @default(now())

  @@unique([itemId, warehouseId])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  vendor      Vendor              @relation(fields: [vendorId], references: [id])
  vendorId    String
  requester   User                @relation(fields: [requesterId], references: [id])
  requesterId String
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  warehouseId String
  costCenter  String
  deliveryDate DateTime
  priority    String              @default("Standard")
  notes       String?
  status      PurchaseOrderStatus @default(PENDING_MANAGER)
  createdAt   DateTime            @default(now())

  lines    PurchaseOrderLine[]
  approvals ApprovalStep[]
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  description     String
  qty             Int
  unitPrice       Decimal       @db.Decimal(12, 2)
}

model ApprovalStep {
  id              String         @id @default(cuid())
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  role            Role
  approverName    String
  sequence        Int
  status          ApprovalStatus @default(PENDING)
  comment         String?
  decidedAt       DateTime?
}

model Transaction {
  id        String   @id @default(cuid())
  date      DateTime
  type      String
  reference String
  party     String
  amount    Decimal  @db.Decimal(12, 2)
  status    String
}
